{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "ios": {
        "autoIncrement": "buildNumber",
        "distribution": "store",
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "development": {
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "AUTO"
      }
    }
  }
}
