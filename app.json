{
  "expo": {
    "name": "M10 Market",
    "slug": "m10",
    "version": "1.0.2",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E31E24"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.m10.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E31E24"
      },
      "package": "com.m10.app",
      "versionCode": 4,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#E31E24"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow M10 to use your camera to scan barcodes and place home accessories in your room.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "dbae6ad8-9339-4ae2-a7a5-7fea2be99386"
      }
    },
    "owner": "ferhatnas",
    "runtimeVersion": "58.0.0",
    "updates": {
      "url": "https://u.expo.dev/dbae6ad8-9339-4ae2-a7a5-7fea2be99386"
    }
  }
}
