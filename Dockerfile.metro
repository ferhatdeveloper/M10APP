# M10 — Expo Metro dev server (Expo Go native bundle)
#
# Gerçek yayın: Traefik HTTPS 443 → container:8081 (metro.retailex.app).
# 8081 dışarıya açık değil. Manifest URL'leri EXPO_PACKAGER_PROXY_URL ile
# https://metro.retailex.app olmalı; aksi halde Expo Go :8081'e gider ve düşer.
#
# QR: exps://metro.retailex.app
FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

COPY . .
RUN chmod +x scripts/start-metro.sh

ENV CI=1
ENV EXPO_NO_TELEMETRY=1
ENV EXPO_NO_INTERACTIVE=1
ENV PUBLIC_HOST=metro.retailex.app
ENV EXPO_PACKAGER_HOSTNAME=metro.retailex.app
ENV EXPO_PACKAGER_PROXY_URL=https://metro.retailex.app
ENV EXPO_PORT=8081

EXPOSE 8081

CMD ["scripts/start-metro.sh"]
