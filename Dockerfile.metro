# M10 — Expo Metro (Expo Go native bundle)
# Expo SDK 57 — iPhone Expo Go 57-only.
# EXFINPDKS kalıbı: node:22-bookworm-slim + --offline --port 8081
# QR: exp://metro.retailex.app  /  exp://72.60.182.107:8081
# PROXY: https://metro.retailex.app:443 (HTTPS :8081 kullanma)
FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

COPY . .
RUN chmod +x scripts/start-metro.sh scripts/patch-expo-anonymous-manifest.js
# Best-effort (EXFIN --offline is the real 500 fix). Nested @expo/cli is OK.
RUN node scripts/patch-expo-anonymous-manifest.js

ENV CI=1
ENV EXPO_NO_TELEMETRY=1
ENV EXPO_NO_INTERACTIVE=1
ENV EXPO_NO_DOTENV=1
ENV EXPO_OFFLINE=1
ENV EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
ENV PUBLIC_HOST=metro.retailex.app
ENV EXPO_PACKAGER_HOSTNAME=metro.retailex.app
ENV REACT_NATIVE_PACKAGER_HOSTNAME=metro.retailex.app
ENV EXPO_PACKAGER_PROXY_URL=https://metro.retailex.app:443
ENV EXPO_PORT=8081

EXPOSE 8081 19000 19001

CMD ["scripts/start-metro.sh"]
