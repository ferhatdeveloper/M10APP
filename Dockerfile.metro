# M10 — Expo Metro dev server (Expo Go native bundle)
#
# EXFINPDKS pattern'i ile aynı: node_modules + kaynak kodu container'a
# kopyala, ardından `expo start` çalıştır. Traefik bu container'ın 8081
# portunu doğrudan dışarıya açar; Metro kendi kendine WebSocket ile bağlanır.
#
# QR: exp://apk.retailex.app:8081
FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

COPY . .

# Metro dev server'ı başlat. Host 0.0.0.0 ile dışarıdan erişilebilir.
# --non-interactive: container içinde soru sorma.
CMD ["npx", "expo", "start", \
     "--host", "0.0.0.0", \
     "--port", "8081", \
     "--non-interactive"]
